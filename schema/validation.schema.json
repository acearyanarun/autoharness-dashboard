{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autoharness-data:validation:1",
  "title": "validation.json",
  "description": "Result of every check. status is fail when any error-severity check failed.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Contract version; consumers must accept any 1.x.y."
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "pass",
        "fail",
        "skipped"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "message": {
            "type": "string"
          },
          "expected": {},
          "actual": {}
        },
        "required": [
          "id",
          "severity",
          "status",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "counts",
    "checks"
  ],
  "additionalProperties": false
}
