{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autoharness-data:functions-crate:1",
  "title": "functions/<crate>.json",
  "description": "Every listed function of one crate, sorted by name. detail is Kani's reason text verbatim.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Contract version; consumers must accept any 1.x.y."
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "crate": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "generated",
              "skipped"
            ]
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "detail": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "status": {
              "const": "skipped"
            }
          }
        },
        "then": {
          "required": [
            "category",
            "detail"
          ]
        },
        "else": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "category"
                ]
              },
              {
                "required": [
                  "detail"
                ]
              },
              {
                "required": [
                  "args"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "crate",
    "functions"
  ],
  "additionalProperties": false
}
